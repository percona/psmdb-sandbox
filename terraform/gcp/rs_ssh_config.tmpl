%{ endif ~}
%{ if hostname_plgm != "" ~}
Host ${hostname_plgm}
  Hostname ${public_ip_plgm}
  User ${my_ssh_user}
  %{ if ssh_private_key_path != "" }IdentityFile ${ssh_private_key_path}%{ endif }
