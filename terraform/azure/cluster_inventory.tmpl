[cfg]
%{ for index, group in ansible_group_cfg ~}
${hostname_cfg[index]} ansible_host=${ip_cfg[index]}${ index == 0 ? " mongodb_primary=True" : "" }
%{ endfor ~}

[shards:children]
%{ for shard_index in number_of_shards ~}
shard${shard_index}
%{ endfor ~}

%{ for shard_index in number_of_shards ~}
[shard${shard_index}]
%{ for index, group in ansible_group_shards ~}
${ group == tostring(shard_index) && ansible_group_index[index] == "0" ? join("", [ hostname_shards[index], " ansible_host=", ip_shards[index], " mongodb_primary=True\n" ]) : "" ~}
${ group == tostring(shard_index) && ansible_group_index[index] != "0" ? join("", [ hostname_shards[index], " ansible_host=", ip_shards[index], "\n" ]) : "" ~}
%{ endfor ~}
%{ for arb_index, arb_group in ansible_group_arbiters ~}
${ arb_group == tostring(shard_index) ? join("", [ hostname_arbiters[arb_index], " ansible_host=", ip_arbiters[arb_index], " arbiter=True\n" ]) : "" ~}
%{ endfor ~}

%{ endfor ~}
[mongos]
%{ for index, group in ansible_group_mongos ~}
${hostname_mongos[index]} ansible_host=${ip_mongos[index]}
%{ endfor ~}

%{ if hostname_pmm != "" ~}
[pmm]
${hostname_pmm} ansible_host=${ip_pmm}

%{ endif ~}
%{ if hostname_ca != "" ~}
[ca]
${hostname_ca} ansible_host=${ip_ca}

%{ endif ~}
%{ if hostname_plgm != "" ~}
[plgm]
${hostname_plgm} ansible_host=${ip_plgm}

%{ endif ~}
%{ if enable_ldap ~}
[ldap]
${ldap_hostname} ansible_host=${ldap_ip}

%{ endif ~}
[all:vars]
${vault_inventory}
[all:vars]
# Ansible connection
ansible_user=${my_ssh_user}
%{ if ssh_private_key_path != "" ~}
ansible_ssh_private_key_file=${ssh_private_key_path}
%{ endif ~}
ansible_ssh_common_args=-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null

# Deployment
cluster=${cluster}
env_tag=${env_tag}
pcsm_version=${pcsm_version}

# MongoDB
%{ if mongodb_distribution != "" ~}
mongodb_distribution=${mongodb_distribution}
%{ endif ~}
%{ if mongo_release != "" ~}
mongo_release=${mongo_release}
%{ endif ~}
%{ if mongo_version != "" ~}
mongo_version=${mongo_version}
%{ endif ~}
%{ if mongo_repo != "" ~}
mongo_repo=${mongo_repo}
%{ endif ~}

# TLS
use_tls=${use_tls}

# Audit
enable_audit=${enable_audit}
%{ if audit_filter != "" ~}
audit_filter=${audit_filter}
%{ endif ~}

# LDAP
enable_ldap=${enable_ldap}
%{ if enable_ldap ~}
ldap_server=${ldap_endpoint}
ldap_domain=${ldap_domain}
ldap_org=${ldap_org}
ldap_base_dn=${ldap_base_dn}
ldap_users_dn=${ldap_users_dn}
ldap_admin_dn=${ldap_admin_dn}
ldap_admin_password=${ldap_admin_password}
ldap_users=${ldap_users}
ldap_mongodb_users=${ldap_mongodb_users}
%{ endif ~}

# MongoDB Search
enable_mongot=${enable_mongot}
mongot_source=${mongot_source}
%{ if mongot_repo != "" ~}
mongot_repo=${mongot_repo}
%{ endif ~}
mongot_version=${mongot_version}

# PMM
enable_pmm=${enable_pmm}
enable_pmm_agent=${enable_pmm_agent}
pmm_image=${pmm_image}
%{ if pmm_client_version != "" ~}
pmm_client_version=${pmm_client_version}
%{ endif ~}
%{ if pmm_client_repo != "" ~}
pmm_client_repo=${pmm_client_repo}
%{ endif ~}

# PBM
enable_pbm=${enable_pbm}
%{ if use_backup_storage ~}
bucket=${bucket}
region=${location}
endpointUrl=${endpointUrl}
key=${key}
storage_provider=azure
account=${account}
%{ endif ~}
%{ if pbm_version != "" ~}
pbm_version=${pbm_version}
%{ endif ~}
%{ if pbm_repo != "" ~}
pbm_repo=${pbm_repo}
%{ endif ~}
