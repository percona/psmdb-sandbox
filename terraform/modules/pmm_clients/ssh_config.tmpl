%{ if include_pmm ~}
Host ${hostname_pmm}
  Hostname ${public_ip_pmm}
  User ${my_ssh_user}
  %{ if ssh_private_key_path != "" }IdentityFile ${ssh_private_key_path}%{ endif }
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  CheckHostIP no
  LocalForward ${port_to_forward} 127.0.0.1:${pmm_port}
  %{ if enable_ssh_gateway }ProxyCommand ssh -W %h:%p ${ssh_gateway_name}%{ endif }
%{ endif ~}
%{ for name, ip in pmm_bare_clients ~}
Host ${name}
  Hostname ${ip}
  User ${my_ssh_user}
  %{ if ssh_private_key_path != "" }IdentityFile ${ssh_private_key_path}%{ endif }
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  CheckHostIP no
  %{ if enable_ssh_gateway }ProxyCommand ssh -W %h:%p ${ssh_gateway_name}%{ endif }
%{ endfor ~}
