[Unit]
Description=MongoDB Router Service
Documentation=https://docs.mongodb.org/manual
After=network.target

[Service]
User={{ mongo_os_user }}
Group={{ mongo_os_group }}
Environment="OPTIONS=-f /etc/mongos.conf"
ExecStart=/usr/bin/mongos $OPTIONS
RuntimeDirectory=mongos
PIDFile=/run/mongos/mongos.pid
Type=forking
# file size
LimitFSIZE=infinity
# cpu time
LimitCPU=infinity
# virtual memory size
LimitAS=infinity
# open files
LimitNOFILE=64000
# processes/threads
LimitNPROC=64000
# locked memory
LimitMEMLOCK=infinity
# total threads (user+kernel)
TasksMax=infinity
TasksAccounting=false

[Install]
WantedBy=multi-user.target
