# mongos.conf - mongos server

# for documentation of all options, see:
#   http://docs.mongodb.org/manual/reference/configuration-options/

# where to write logging data.
systemLog:
  destination: file
  logAppend: true
  logRotate: reopen
  path: {{ mongod_log_path }}/mongos.log

{% if enable_audit_effective %}
auditLog:
  destination: file
  format: JSON
  path: {{ audit_log_path }}
  filter: {{ (audit_filter_effective if audit_filter_effective is string else audit_filter_effective | to_json) | to_json }}
{% endif %}

# how the process runs
processManagement:
  fork: true  # fork and run in background
  pidFilePath: /run/mongos/mongos.pid  # location of pidfile
  timeZoneInfo: /usr/share/zoneinfo

# network interfaces
net:
  port: {{ mongo_port }}
  bindIp: localhost,{{ hostvars[inventory_hostname]['ansible_facts']['default_ipv4']['address'] }}
{% if use_tls | bool %}
  tls:
    mode: preferTLS
    certificateKeyFile: {{ certificateKeyFile }}
    CAFile: {{ CAFile }}
    allowConnectionsWithoutCertificates: true

security:
{% if enable_ldap | default(false) | bool %}
  authenticationMechanisms: [SCRAM-SHA-256, PLAIN]
  ldap:
    servers: {{ ldap_server }}:{{ ldap_port | default(389) }}
    bind:
      queryUser: {{ ldap_admin_dn }}
      queryPassword: {{ ldap_admin_password }}
    userToDNMapping: '[ { match : "(.+)", substitution : "uid={0},{{ ldap_users_dn }}" } ]'
    transportSecurity: none
{% endif %}
  clusterAuthMode: x509
{% else %}
security:
{% if enable_ldap | default(false) | bool %}
  authenticationMechanisms: [SCRAM-SHA-256, PLAIN]
  ldap:
    servers: {{ ldap_server }}:{{ ldap_port | default(389) }}
    bind:
      queryUser: {{ ldap_admin_dn }}
      queryPassword: {{ ldap_admin_password }}
    userToDNMapping: '[ { match : "(.+)", substitution : "uid={0},{{ ldap_users_dn }}" } ]'
    transportSecurity: none
{% endif %}
  keyFile: {{ keyFile_location }}
{% endif %}

operationProfiling:
   slowOpThresholdMs: 200
#   slowOpSampleRate: 0.1
{% if mongodb_distribution_effective == 'psmdb' %}
   rateLimit: 100
{% endif %}

{% if enable_audit_effective or (enable_mongot_effective | bool and (groups['shards'] | default([]) | length) > 0) %}
setParameter:
{% if enable_audit_effective %}
  auditAuthorizationSuccess: true
{% endif %}
{% if enable_mongot_effective | bool and (groups['shards'] | default([]) | length) > 0 %}
  searchIndexManagementHostAndPort: {{ hostvars[groups['shards'][0]].ansible_facts['default_ipv4']['address'] }}:{{ mongot_port }}
  mongotHost: {{ hostvars[groups['shards'][0]].ansible_facts['default_ipv4']['address'] }}:{{ mongot_port }}
  skipAuthenticationToSearchIndexManagementServer: false
  useGrpcForSearch: true
  searchTLSMode: disabled
{% endif %}
{% endif %}

sharding:
  configDB: {{ cluster }}-cfg/{% for h in groups[ 'cfg' ] %}{{ hostvars[h].ansible_facts['fqdn'] }}:{{ cfg_server_port }}{% if not loop.last %},{% endif %}{% endfor %}
