[Unit]
Description=plgm - Percona Load Generator for MongoDB (Web UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ plgm_service_user }}
WorkingDirectory={{ plgm_data_dir }}
Environment=HOME={{ plgm_data_dir }}
Environment=PLGM_DEFINITIONS_STORE={{ plgm_data_dir }}/definitions.json
ExecStart=/usr/local/bin/plgm --webui --webui-port {{ plgm_webui_port }}
# Keep oversized workloads from exhausting host memory.
MemoryMax={{ plgm_memory_max }}
# The Web UI "Shut Down Backend" button exits the process; bring it back.
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
